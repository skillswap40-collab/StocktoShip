# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocktoship
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocktoship_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=60

# Tax ID protection. Development uses built-in keys; production refuses to start without these.
# Encryption key (Fernet). Comma-separated list: the first encrypts, all decrypt (key rotation).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Hash key (HMAC for duplicate detection):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: never change DATA_HASH_KEY once real data exists - duplicate detection breaks.
# WARNING: back up BOTH keys. Losing DATA_ENCRYPTION_KEY makes stored tax IDs unrecoverable.
# DATA_ENCRYPTION_KEY=
# DATA_HASH_KEY=

CORS_ORIGINS=http://localhost:5173
